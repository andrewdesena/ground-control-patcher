{
  "name": "poly-lifecycle-load",
  "status": "experimental",
  "description": "Read embedded records for an active destination, then install them with the native steps under the same mutex.",
  "cave": {
    "addr": "0x8049000",
    "asm": [
      "mov ip, sp",
      "push {r4-r8, lr}",
      "mov r8, ip",
      "movs r0, #0",
      "str r0, [r8, #0x20]",
      "mov r0, r4",
      "bl 0x0804a000",
      "cbz r0, done",
      "ldrb r6, [r3, #0x2e]",
      "cmp r6, r2",
      "bne done",
      "add r0, r8, #0x38",
      "ldr r1, =0x1000d750",
      "bl 0x0804b900",
      "str r0, [r8, #0x20]",
      "done:",
      "mov.w r3, #-1",
      "pop {r4-r8, pc}",
      ".ltorg"
    ]
  },
  "patches": [
    {
      "addr": "0x0801cd74",
      "asm": [
        "bl 0x08049100"
      ],
      "note": "Clear the active bank if the native file did not open"
    },
    {
      "addr": "0x0801ce16",
      "asm": [
        "bl 0x08049106"
      ],
      "note": "Publish chord records at the same unlock as native steps"
    },
    {
      "addr": "0x08049100",
      "note": "Load completion shares the native pattern mutex",
      "asm": [
        "movs r3, #0",
        "b.n publish",
        "nop",
        "ldr r3, [sp, #0x20]",
        "publish:",
        "push {r4, lr}",
        "sub.w r0, r4, #0x18c",
        "mov r4, r3",
        "bl 0x0804a000",
        "cbz r0, unlock",
        "ldrb r3, [r3, #0x2e]",
        "cmp r3, r2",
        "bne unlock",
        "mov r3, r4",
        "bl 0x0804bb00",
        "unlock:",
        "pop {r4, lr}",
        "b.w 0x080232b0"
      ]
    }
  ]
}
