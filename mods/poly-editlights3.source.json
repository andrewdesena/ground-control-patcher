{
  "name": "EDIT chord key lights v3",
  "status": "experimental",
  "description": "EDIT mode: OR chord notes into the LED buffer via the real manager structure. Uses manager pointer table at 0x20000450, EDIT flag at manager+0x2DC, step cursor at manager+0x2DF, track pointer table 0x08038370, and active_letter*0x194 stride. EDIT-mode gated; playback silent.",
  "cave": {
    "addr": "0x08048B30",
    "asm": [
      "push {r4, r5, r6, r7, lr}",

      "@ Read track selector from 0x2000CADA (1-based, 1-4)",
      "ldr r5, =0x2000CADA",
      "ldrb r4, [r5]",
      "subs r4, #1",
      "cmp r4, #3",
      "bhs done",

      "@ Get manager pointer from table 0x20000450 + track*4",
      "@ The manager has: +0x2DC=EDIT flag, +0x2DF=step cursor",
      "ldr r5, =0x20000450",
      "ldr r5, [r5, r4, lsl #2]",

      "@ Check EDIT-mode flag at manager+0x2DC",
      "ldrb r1, [r5, #0x2dc]",
      "cmp r1, #0",
      "beq done",

      "@ Read step cursor from manager+0x2DF",
      "ldrb r6, [r5, #0x2df]",

      "@ Get track pointer from table 0x08038370 + track*4",
      "ldr r5, =0x08038370",
      "ldr.w r5, [r5, r4, lsl #2]",

      "@ Read active letter at track_ptr+0x2E",
      "ldrb r7, [r5, #0x2e]",

      "@ Read primary note: track_ptr + 0x34 + letter*0x194 + 8 + step*3",
      "mov.w r3, #0x194",
      "mla r3, r7, r3, r5",
      "add.w r2, r6, r6, lsl #1",
      "add r3, r2",
      "ldrb r3, [r3, #0x3c]",

      "@ Read LED buffer (3 bytes at 0x20001E74)",
      "ldr r5, =0x20001E74",
      "ldrb r0, [r5, #0]",
      "ldrb r1, [r5, #1]",
      "ldrb r2, [r5, #2]",
      "lsls r1, r1, #8",
      "lsls r2, r2, #16",
      "orrs r0, r1",
      "orrs r0, r2",

      "@ Skip if 0 bits or more than 1 bit",
      "cmp r0, #0",
      "beq done",
      "movs r1, r0",
      "subs r1, #1",
      "ands r1, r0",
      "cmp r1, #0",
      "bne done",

      "@ CTZ: find lit bit position",
      "uxtb r1, r0",
      "movs r2, #0",
      "cmp r1, #0",
      "beq c1",
      "tz0: tst r1, #1",
      "bne hb",
      "lsrs r1, #1",
      "adds r2, #1",
      "b tz0",
      "c1: ubfx r1, r0, #8, #8",
      "movs r2, #8",
      "cmp r1, #0",
      "beq c2",
      "tz1: tst r1, #1",
      "bne hb",
      "lsrs r1, #1",
      "adds r2, #1",
      "b tz1",
      "c2: ubfx r1, r0, #16, #8",
      "movs r2, #16",
      "tz2: tst r1, #1",
      "bne hb",
      "lsrs r1, #1",
      "adds r2, #1",
      "b tz2",

      "@ hb: r2 = bit position of lit key",
      "hb: ldr r5, =0x08048B00",
      "ldrb r5, [r5, r2]",

      "@ base = primary_note - key_index",
      "subs r3, r3, r5",

      "@ Chord bank: 0x1000B530 + track*0x880 + step*17",
      "ldr r5, =0x1000B530",
      "mov.w r1, #0x880",
      "mla r5, r4, r1, r5",
      "add.w r2, r6, r6, lsl #4",
      "add r5, r2",

      "@ Chord count, cap at 8",
      "ldrb r1, [r5]",
      "cmp r1, #0",
      "beq done",
      "cmp r1, #8",
      "bls co",
      "movs r1, #8",
      "co: movs r4, #0",

      "@ Loop: process each chord note",
      "loop: cmp r4, r1",
      "bge done",
      "add.w r2, r4, r4",
      "add r2, r5",
      "ldrb r6, [r2, #1]",
      "subs r6, r6, r3",
      "bmi next",
      "cmp r6, #23",
      "bgt next",
      "ldr r2, =0x08048B18",
      "ldrb r0, [r2, r6]",
      "lsrs r6, r0, #3",
      "and r0, r0, #7",
      "movs r7, #1",
      "lsls r7, r7, r0",
      "ldr r2, =0x20001E74",
      "add r2, r6",
      "ldrb r0, [r2]",
      "orrs r0, r7",
      "strb r0, [r2]",
      "next: adds r4, #1",
      "b loop",

      "@ Restore registers for SPI call",
      "done:",
      "ldr r1, =0x20001E74",
      "ldr r0, =0x20002B2C",
      "pop {r4, r5, r6, r7, lr}",
      "bx lr"
    ]
  },
  "patches": [
    {
      "addr": "0x08012068",
      "asm": [ "bl 0x08048B30" ],
      "note": "OR chord key bits before SPI shift-out"
    },
    {
      "addr": "0x08048B00",
      "bytes": "1315170c0e100d0f110416141203010608050702000b090a140e130d09110f12101617150306040705080c000b010a02",
      "note": "bit->keyIdx (24 bytes) then keyIdx->bit (24 bytes)"
    }
  ],
  "requires": {
    "blank": [ "0x08048B00", "0x08048C00" ]
  }
}