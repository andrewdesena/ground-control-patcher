{
  "name": "EDIT chord key lights v2",
  "status": "experimental",
  "description": "EDIT mode: when stock lights exactly one key in the LED buffer, OR the remaining stored chord notes' key bits. Reads the real edit cursor from the manager, scales by active_letter*0x194, and uses the correct track pointer table base. Set-only, never clears.",
  "cave": {
    "addr": "0x08048B30",
    "asm": [
      "push {r4, r5, r6, r7, lr}",

      "@ Read manager state: track (1-based) and step",
      "ldr r5, =0x20006000",
      "ldrb r4, [r5, #0x2e1]",
      "subs r4, #1",
      "cmp r4, #3",
      "bhs done",
      "ldrb r6, [r5, #0x2df]",

      "@ Look up track parent pointer from table 0x08038370",
      "ldr r5, =0x08038370",
      "ldr.w r5, [r5, r4, lsl #2]",

      "@ Read active letter and primary note from the correct pattern",
      "ldrb r7, [r5, #0x2e]",
      "mov.w r3, #0x194",
      "mla r3, r7, r3, r5",
      "add.w r2, r6, r6, lsl #1",
      "add r3, r2",
      "ldrb r3, [r3, #0x3c]",

      "@ Read the 24-bit LED buffer at 0x20001E74",
      "ldr r5, =0x20001E74",
      "ldrb r0, [r5, #0]",
      "ldrb r1, [r5, #1]",
      "ldrb r2, [r5, #2]",
      "lsls r1, r1, #8",
      "lsls r2, r2, #16",
      "orrs r0, r1",
      "orrs r0, r2",

      "@ Skip if buffer has 0 bits or more than 1 bit set",
      "cmp r0, #0",
      "beq done",
      "movs r1, r0",
      "subs r1, #1",
      "ands r1, r0",
      "cmp r1, #0",
      "bne done",

      "@ Count trailing zeros to find the lit bit position (0-23)",
      "uxtb r1, r0",
      "movs r2, #0",
      "cmp r1, #0",
      "beq c1",
      "tz0:",
      "tst r1, #1",
      "bne hb",
      "lsrs r1, #1",
      "adds r2, #1",
      "b tz0",
      "c1:",
      "ubfx r1, r0, #8, #8",
      "movs r2, #8",
      "cmp r1, #0",
      "beq c2",
      "tz1:",
      "tst r1, #1",
      "bne hb",
      "lsrs r1, #1",
      "adds r2, #1",
      "b tz1",
      "c2:",
      "ubfx r1, r0, #16, #8",
      "movs r2, #16",
      "tz2:",
      "tst r1, #1",
      "bne hb",
      "lsrs r1, #1",
      "adds r2, #1",
      "b tz2",

      "@ hb: r2 = bit position of the lit primary key",
      "hb:",
      "ldr r5, =0x08048B00",
      "ldrb r5, [r5, r2]",

      "@ base = primary_note - key_index_of_primary",
      "subs r3, r3, r5",

      "@ Read chord bank: 0x1000B530 + track*0x880 + step*17",
      "ldr r5, =0x1000B530",
      "mov.w r1, #0x880",
      "mla r5, r4, r1, r5",
      "add.w r2, r6, r6, lsl #4",
      "add r5, r2",

      "@ Read chord count, cap at 8",
      "ldrb r1, [r5]",
      "cmp r1, #0",
      "beq done",
      "cmp r1, #8",
      "bls co",
      "movs r1, #8",
      "co:",

      "@ Iterate chord notes (0-based counter in r4)",
      "movs r4, #0",
      "loop:",
      "cmp r4, r1",
      "bge done",

      "@ Read chord note: bank + counter*2, note at offset 1",
      "add.w r2, r4, r4",
      "add r2, r5",
      "ldrb r6, [r2, #1]",

      "@ delta = chord_note - base; skip if <0 or >23",
      "subs r6, r6, r3",
      "bmi next",
      "cmp r6, #23",
      "bgt next",

      "@ Map delta to bit position via keyIdx->bit table",
      "ldr r2, =0x08048B18",
      "ldrb r0, [r2, r6]",

      "@ Set the bit in the LED buffer",
      "lsrs r6, r0, #3",
      "and r0, r0, #7",
      "movs r7, #1",
      "lsls r7, r7, r0",
      "ldr r2, =0x20001E74",
      "add r2, r6",
      "ldrb r0, [r2]",
      "orrs r0, r7",
      "strb r0, [r2]",

      "next:",
      "adds r4, #1",
      "b loop",

      "@ Restore registers and set up r0/r1 for the SPI call",
      "done:",
      "ldr r1, =0x20001E74",
      "ldr r0, =0x20002B2C",
      "pop {r4, r5, r6, r7, lr}",
      "bx lr"
    ]
  },
  "patches": [
    {
      "addr": "0x08012068",
      "asm": [ "bl 0x08048B30" ],
      "note": "OR chord key bits before SPI shift-out"
    },
    {
      "addr": "0x08048B00",
      "bytes": "1315170c0e100d0f110416141203010608050702000b090a140e130d09110f12101617150306040705080c000b010a02",
      "note": "bit->keyIdx (24 bytes) then keyIdx->bit (24 bytes)"
    }
  ],
  "requires": {
    "blank": [ "0x08048B00", "0x08048C00" ]
  }
}