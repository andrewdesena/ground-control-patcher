{
  "name": "poly-record",
  "status": "experimental",
  "description": "Layer: wire held-note capture into the record path. Replaces the armed single-note store at 0x08025814 (2-byte strb + 2-byte b) with a b.w to a cave that (1) DOES the original store verbatim, then (2) merges the note into a per-(track,step) poly array in CCM at 0x1000B530. Additive: original playback data is untouched. Layout per step: byte0=count(<=8), entries [note,vel] at +1+2*i (stride 17). Per-track stride 128*17=0x880; 3 melodic tracks. poly_merge clips a stale count>8 to 0 (no boot-init needed).",
  "cave": {
    "addr": "0x08047400",
    "asm": [
      "push {r0, r1, r2, r3, r5, lr}",
      "strb r1, [r3, #0x1d]",
      "bl 0x080232f0",
      "uxtb r0, r0",
      "cmp r0, #2",
      "bhi 9f",
      "ldrb r2, [r4, #5]",
      "mov r3, r0",
      "lsls r3, r3, #11",
      "add r3, r3, r0, lsl #7",
      "add r3, r3, r2, lsl #4",
      "add r3, r3, r2",
      "movw r0, #0xb530",
      "movt r0, #0x1000",
      "add r0, r0, r3",
      "mov r1, r5",
      "movw r2, #0xfd00",
      "movt r2, #0x1000",
      "add r2, r2, r1",
      "ldrb r2, [r2]",
      "cmp r2, #0",
      "bne 8f",
      "movs r2, #100",
      "8:",
      "bl poly_merge",
      "9:",
      "pop {r0, r1, r2, r3, r5, lr}",
      "b.w 0x080257f8",
      "poly_merge:",
      "push {r4, r5, r6, lr}",
      "ldrb r3, [r0]",
      "cmp r3, #8",
      "bls 5f",
      "movs r3, #0",
      "strb r3, [r0]",
      "5:",
      "movs r4, #0",
      "1:",
      "cmp r4, r3",
      "bhs 3f",
      "add r5, r0, #1",
      "add r5, r5, r4, lsl #1",
      "ldrb r6, [r5]",
      "cmp r6, r1",
      "beq 2f",
      "adds r4, #1",
      "b 1b",
      "2:",
      "strb r2, [r5, #1]",
      "b 4f",
      "3:",
      "cmp r3, #8",
      "bhs 4f",
      "add r5, r0, #1",
      "add r5, r5, r3, lsl #1",
      "strb r1, [r5]",
      "strb r2, [r5, #1]",
      "adds r3, #1",
      "strb r3, [r0]",
      "4:",
      "mov r0, r3",
      "pop {r4, r5, r6, pc}"
    ]
  },
  "patches": [
    { "addr": "0x08025814", "asm": ["b.w 0x08047400"], "note": "armed step store -> cave (store+poly capture)" }
  ],
  "requires": { "blank": ["0x08047400", "0x08047FFF"] }
}
