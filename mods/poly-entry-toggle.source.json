{
  "name": "Toggle chord entry",
  "status": "experimental",
  "description": "Toggle notes in an owned EDIT chord. Initialize a fresh bank on a letter change, discard records that disagree with the live step, and delegate fresh chords to held-key entry. Write native step data and mark edits dirty.",
  "cave": {
    "addr": "0x0804B500",
    "asm": [
      "@ in: r0 block, r1 step, r2 three byte record {note, velocity, modifier}",
      "push {r0, r1, r2, r3, r4, r5, r6, r7, lr}",
      "sub sp, #4",
      "mov r6, r1",
      "mov r5, r2",
      "mov r7, r0",
      "cmp r6, #128",
      "bhs.w native_only",
      "ldr r3, =0x2001C230",
      "ldrb r0, [r3, #4]",
      "cmp r0, #1",
      "bne.w native_only",
      "ldr r0, [r3, #8]",
      "cmp r0, r7",
      "bne.w native_only",
      "bl 0x0804B7A0",
      "cmp r0, #0",
      "beq.w native_only",
      "movw r2, #17",
      "mla r3, r6, r2, r0",
      "ldrb r4, [r3]",
      "cbz r4, empty_record",
      "cmp r4, #8",
      "bhi empty_record",
      "adds r7, #8",
      "movs r1, #3",
      "mla r7, r6, r1, r7",
      "@ A record with no matching live primary is stale, even for the right letter.",
      "ldrb r0, [r7]",
      "cmp r0, #128",
      "bhs empty_record",
      "movs r2, #1",
      "adds r1, r4, r4",
      "validate:",
      "ldrb r6, [r3, r2]",
      "cmp r6, r0",
      "beq valid_record",
      "adds r2, #2",
      "cmp r2, r1",
      "blo validate",
      "empty_record:",
      "movs r0, #0",
      "strb r0, [r3]",
      "b.w passthru",
      "valid_record:",
      "ldrb r0, [r5]",
      "cmp r0, #0x80",
      "beq.w clear_all",
      "cmp r0, #1",
      "blo.w unchanged",
      "cmp r0, #127",
      "bhi.w unchanged",
      "@ search: limit = count*2 + 1, then search the declared pairs",
      "adds r4, r4, r4",
      "adds r4, #1",
      "movs r2, #1",
      "find:",
      "cmp r2, r4",
      "bhs.w not_found",
      "ldrb r1, [r3, r2]",
      "cmp r1, r0",
      "beq found",
      "adds r2, #2",
      "b find",
      "found:",
      "@ r2 = byte position of note to remove, r3 = record, r4 = limit",
      "mov r0, r2",
      "movs r1, #1",
      "movs r2, #1",
      "movs r5, #0",
      "b comp",
      "clear_all:",
      "@ 0x80: check velocity to distinguish Rest/clear (vel=0) from",
      "@ a root-note re-press that stock converted to 0x80 (vel>0).",
      "@ vel=0 -> clear entire record. vel>0 -> remove just the primary.",
      "ldrb r1, [r5, #1]",
      "cmp r1, #0",
      "bne remove_primary",
      "@ Clear entire record and set step note to 0x80",
      "movs r0, #0",
      "strb r0, [r3]",
      "movs r1, #1",
      "c_loop:",
      "cmp r1, #17",
      "bhs c_done",
      "strb r0, [r3, r1]",
      "adds r1, #1",
      "b c_loop",
      "c_done:",
      "b make_rest",
      "remove_primary:",
      "@ r2 already points to the pair that matched the live primary.",
      "mov r0, r2",
      "@ compute limit = count*2 + 1 for compaction",
      "adds r4, r4, r4",
      "adds r4, #1",
      "movs r1, #1",
      "movs r2, #1",
      "movs r5, #0",
      "b comp",
      "comp:",
      "cmp r1, r4",
      "bhs comp_done",
      "cmp r1, r0",
      "beq comp_skip",
      "ldrb r6, [r3, r1]",
      "strb r6, [r3, r2]",
      "adds r1, #1",
      "adds r2, #1",
      "ldrb r6, [r3, r1]",
      "strb r6, [r3, r2]",
      "adds r1, #1",
      "adds r2, #1",
      "adds r5, #1",
      "b comp",
      "comp_skip:",
      "adds r1, #2",
      "b comp",
      "comp_done:",
      "strb r5, [r3]",
      "movs r6, #0",
      "tail:",
      "cmp r2, #17",
      "bhs set_note",
      "strb r6, [r3, r2]",
      "adds r2, #1",
      "b tail",
      "set_note:",
      "cmp r5, #0",
      "beq make_rest",
      "movs r1, #0",
      "movs r2, #0xFF",
      "minloop:",
      "cmp r1, r5",
      "bhs min_done",
      "add r6, r1, r1",
      "adds r6, #1",
      "ldrb r6, [r3, r6]",
      "cmp r6, r2",
      "bhs min_next",
      "mov r2, r6",
      "add.w r0, r1, r1",
      "adds r0, #2",
      "ldrb r0, [r3, r0]",
      "min_next:",
      "adds r1, #1",
      "b minloop",
      "min_done:",
      "strb r2, [r7]",
      "strb r0, [r7, #1]",
      "b done",
      "make_rest:",
      "movs r2, #0x80",
      "strb r2, [r7]",
      "movs r2, #0",
      "strb r2, [r7, #1]",
      "ldrb r2, [r7, #2]",
      "bic r2, r2, #7",
      "strb r2, [r7, #2]",
      "b done",
      "done:",
      "@ Set dirty flag on all modification paths",
      "ldr r4, [sp, #4]",
      "movs r6, #1",
      "strh r6, [r4, #4]",
      "unchanged:",
      "add sp, #4",
      "pop {r0, r1, r2, r3, r4, r5, r6, r7, lr}",
      "bx lr",
      "not_found:",
      "@ Append the new pair and update the matching native step.",
      "ldrb r1, [r3]",
      "cmp r1, #8",
      "bhs.w unchanged",
      "@ Add the new note at position count*2+1",
      "mov r2, r1",
      "adds r2, r2, r2",
      "adds r2, #1",
      "strb r0, [r3, r2]",
      "adds r2, #1",
      "ldrb r4, [r5, #1]",
      "strb r4, [r3, r2]",
      "adds r1, #1",
      "strb r1, [r3]",
      "@ Zero tail from new count*2+1 to 16",
      "mov r2, r1",
      "adds r2, r2, r2",
      "adds r2, #1",
      "movs r6, #0",
      "nf_tail:",
      "cmp r2, #17",
      "bhs nf_set_note",
      "strb r6, [r3, r2]",
      "adds r2, #1",
      "b nf_tail",
      "nf_set_note:",
      "@ Find lowest note in the chord record for the step note",
      "movs r2, #0xFF",
      "movs r4, #0",
      "nf_min:",
      "cmp r4, r1",
      "bhs nf_min_done",
      "add r6, r4, r4",
      "adds r6, #1",
      "ldrb r6, [r3, r6]",
      "cmp r6, r2",
      "bhs nf_min_next",
      "mov r2, r6",
      "add.w r0, r4, r4",
      "adds r0, #2",
      "ldrb r0, [r3, r0]",
      "nf_min_next:",
      "adds r4, #1",
      "b nf_min",
      "nf_min_done:",
      "strb r2, [r7]",
      "strb r0, [r7, #1]",
      "ldrb r4, [r5, #2]",
      "strb r4, [r7, #2]",
      "b done",
      "native_only:",
      "add sp, #4",
      "pop {r0-r7, lr}",
      "b.w 0x0802705c",
      "passthru:",
      "add sp, #4",
      "pop {r0, r1, r2, r3, r4, r5, r6, r7, lr}",
      "b #0x08049C00",
      ".ltorg"
    ]
  },
  "patches": [
    {
      "addr": "0x080275C0",
      "asm": [
        "bl #0x0804B500"
      ],
      "note": "replaces the direct call into the entry cave; wrapper decides add or remove"
    }
  ]
}
