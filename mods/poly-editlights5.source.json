{
  "name": "EDIT chord key lights v5",
  "status": "experimental",
  "description": "EDIT mode: OR the edited step's stored chord notes into the LED buffer next to the primary key stock already lit. Finds the track from the manager table at 0x20000450 (4 slots, stock initialises each with its own 0-based id at +0x2E1 via 0x0801F26C, and 0x0801FF26 proves the table is indexed that way), requires that manager's EDIT flag at +0x2DC, takes the step cursor from +0x2DF, and scales the stored pattern by active_letter*0x194. No track selector global is consulted. Set-only, never clears, no SD I/O.",
  "cave": {
    "addr": "0x08048C00",
    "asm": [
      "push {r4, r5, r6, r7, lr}",
      "@ ---- require exactly one key lit (stock's primary note) ----",
      "ldr r5, =0x20001E74",
      "ldrb r0, [r5, #0]",
      "ldrb r1, [r5, #1]",
      "lsls r1, r1, #8",
      "orrs r0, r1",
      "ldrb r1, [r5, #2]",
      "lsls r1, r1, #16",
      "orrs r0, r1",
      "cmp r0, #0",
      "beq done",
      "movs r1, r0",
      "subs r1, #1",
      "ands r1, r0",
      "cmp r1, #0",
      "bne done",
      "@ ---- bit position of the lit key -> r2 ----",
      "uxtb r1, r0",
      "movs r2, #0",
      "cmp r1, #0",
      "beq c1",
      "tz0:",
      "tst r1, #1",
      "bne hb",
      "lsrs r1, #1",
      "adds r2, #1",
      "b tz0",
      "c1:",
      "ubfx r1, r0, #8, #8",
      "movs r2, #8",
      "cmp r1, #0",
      "beq c2",
      "tz1:",
      "tst r1, #1",
      "bne hb",
      "lsrs r1, #1",
      "adds r2, #1",
      "b tz1",
      "c2:",
      "ubfx r1, r0, #16, #8",
      "movs r2, #16",
      "tz2:",
      "tst r1, #1",
      "bne hb",
      "lsrs r1, #1",
      "adds r2, #1",
      "b tz2",
      "@ ---- find the manager that is in EDIT mode ----",
      "hb:",
      "ldr r5, =0x20000450",
      "movs r4, #0",
      "pick:",
      "cmp r4, #4",
      "bge done",
      "ldr r6, [r5, r4, lsl #2]",
      "adds r4, #1",
      "cbnz r6, have",
      "b pick",
      "have:",
      "ldrb r1, [r6, #0x2dc]",
      "cmp r1, #0",
      "beq pick",
      "@ the manager carries its own 0-based track id at +0x2e1",
      "ldrb r0, [r6, #0x2e1]",
      "cmp r0, #3",
      "bhi pick",
      "ldrb r1, [r6, #0x2df]",
      "@ ---- track pointer and primary note ----",
      "ldr r6, =0x08038370",
      "ldr.w r7, [r6, r0, lsl #2]",
      "ldrb r6, [r7, #0x2d]",
      "@ stock discriminator: 1 = melodic track",
      "cmp r6, #1",
      "bne pick",
      "ldrb r6, [r7, #0x2e]",
      "mov.w r3, #0x194",
      "mla r3, r6, r3, r7",
      "add.w r6, r1, r1, lsl #1",
      "add r3, r6",
      "ldrb r3, [r3, #0x3c]",
      "@ ---- base = primary note - key index of the lit key ----",
      "ldr r6, =0x08048B00",
      "ldrb r6, [r6, r2]",
      "subs r3, r3, r6",
      "@ ---- chord bank: 0x1000B530 + idx*0x880 + step*17 ----",
      "ldr r5, =0x1000B530",
      "mov.w r6, #0x880",
      "mla r5, r0, r6, r5",
      "add.w r6, r1, r1, lsl #4",
      "add r5, r6",
      "ldrb r1, [r5]",
      "cmp r1, #0",
      "beq done",
      "cmp r1, #8",
      "bls co",
      "movs r1, #8",
      "co:",
      "movs r4, #0",
      "loop:",
      "cmp r4, r1",
      "bge done",
      "add.w r6, r4, r4",
      "add r6, r5",
      "ldrb r6, [r6, #1]",
      "subs r6, r6, r3",
      "bmi next",
      "cmp r6, #23",
      "bgt next",
      "ldr r0, =0x08048B18",
      "ldrb r0, [r0, r6]",
      "lsrs r6, r0, #3",
      "and r0, r0, #7",
      "movs r7, #1",
      "lsls r7, r7, r0",
      "ldr r0, =0x20001E74",
      "add r0, r6",
      "ldrb r6, [r0]",
      "orrs r6, r7",
      "strb r6, [r0]",
      "next:",
      "adds r4, #1",
      "b loop",
      "@ ---- restore the two registers stock loaded before the hook ----",
      "done:",
      "ldr r1, =0x20001E74",
      "ldr r0, =0x20002B2C",
      "pop {r4, r5, r6, r7, lr}",
      "bx lr"
    ]
  },
