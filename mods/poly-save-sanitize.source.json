{
  "name": "Save drops unplayable records",
  "status": "experimental",
  "description": "Snapshot and sanitize the bank owned by the native source block. Use the destination letter from the native writer frame so Save As writes matching pattern and chord files.",
  "cave": {
    "addr": "0x8047e00",
    "asm": [
      "mov ip, sp",
      "push {r4-r8, lr}",
      "mov r7, r4",
      "mov r8, ip",
      "mov r0, r4",
      "bl 0x0804a000",
      "cmp r0, #0",
      "beq close_only",
      "mov r4, r0",
      "mov r5, r1",
      "adds r6, r2, #1",
      "mov.w r0, #-1",
      "bl 0x080232a0",
      "ldr r0, =0x1000D740",
      "ldr r0, [r0, r5, lsl #2]",
      "cmp r0, r6",
      "bne foreign_bank",
      "ldr r0, =0x1000E500",
      "mov r1, r4",
      "movw r2, #2176",
      "snap_loop:",
      "subs r2, #1",
      "ldrb r3, [r1, r2]",
      "strb r3, [r0, r2]",
      "cmp r2, #0",
      "bne snap_loop",
      "@ Sanitize the snapshot WHILE holding the lock so the step",
      "@ notes the sanitizer reads cannot change under us (transpose",
      "@ uses the same lock). This is the save-race fix: the bank",
      "@ snapshot is safe from publish, and the sanitizer is safe",
      "@ from transpose changing primaries mid-scan.",
      "ldr r4, =0x1000E500",
      "movw r0, #0x6f70",
      "movt r0, #0x796c",
      "str r0, [r8, #8]",
      "ldrb r6, [r8, #15]",
      "strb r6, [r8, #12]",
      "movs r0, #0",
      "strb r0, [r8, #13]",
      "@ sanitize: drop records that cannot play",
      "mov r0, r4",
      "add r1, r7, #8",
      "movs r2, #0",
      "san:",
      "ldrb r3, [r0]",
      "cmp r3, #0",
      "beq san_next",
      "cmp r3, #8",
      "bhi san_drop",
      "ldrb r6, [r1]",
      "cmp r6, #0x80",
      "beq san_drop",
      "@ zero the undeclared tail so stale bytes cannot defeat the search",
      "adds r3, r3, r3",
      "adds r3, #1",
      "movs r5, #0",
      "san_tail:",
      "cmp r3, #17",
      "bhs san_tail_done",
      "strb r5, [r0, r3]",
      "adds r3, #1",
      "b san_tail",
      "san_tail_done:",
      "ldrb r5, [r0]",
      "add.w r5, r5, r5",
      "adds r5, #1",
      "movs r3, #1",
      "san_find:",
      "ldrb r12, [r0, r3]",
      "cmp r12, r6",
      "beq san_next",
      "adds r3, #2",
      "cmp r3, r5",
      "blo san_find",
      "san_drop:",
      "movs r5, #0",
      "strb r5, [r0]",
      "san_next:",
      "adds r0, #17",
      "adds r1, #3",
      "adds r2, #1",
      "cmp r2, #0x80",
      "blo san",
      "@ Sanitize done under lock. Now release so f_open/f_write",
      "@ can sleep without blocking other tasks.",
      "bl 0x080232b0",
      "ldr r0, =0x1000ee00",
      "add r1, r8, #8",
      "movs r2, #10",
      "bl 0x0801496c",
      "cmp r0, #0",
      "bne close_only",
      "ldr r0, =0x1000ee00",
      "ldr r1, =0x1000E500",
      "movw r2, #2176",
      "ldr r3, =0x1000f028",
      "bl 0x08014c92",
      "ldr r0, =0x1000ee00",
      "bl 0x08014f18",
      "b close_only",
      "foreign_bank:",
      "bl 0x080232b0",
      "close_only:",
      "add r0, r8, #24",
      "bl 0x08014f18",
      "pop {r4-r8, pc}",
      ".ltorg"
    ]
  },
  "patches": []
}
