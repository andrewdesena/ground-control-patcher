{
  "name": "Deferred chain letter bank publication",
  "status": "experimental",
  "description": "Load chained patterns on the stock SD task, and publish the matching letter and chord bank together. Reject stale requests and keep FatFS out of the timing callback.",
  "cave": {
    "addr": "0x0804be00",
    "asm": [
      "push {r4-r6, lr}",
      "cmp r1, #24",
      "bhs done",
      "ldrb r2, [r0, #0x2d]",
      "cbnz r2, native",
      "ldrb r2, [r0, #0x1f]",
      "subs r2, #1",
      "cmp r2, #3",
      "bhs native",
      "ldr r3, =0x08038374",
      "ldr r3, [r3, r2, lsl #2]",
      "cmp r3, r0",
      "bne native",
      "ldr r3, =0x2000b499",
      "ldrb r3, [r3]",
      "cmp r3, #24",
      "bhs native",
      "ldr r4, =0x1000d734",
      "adds r1, #1",
      "orr r1, r1, r3, lsl #8",
      "strh r1, [r4, r2, lsl #1]",
      "b done",
      "native:",
      "strb r1, [r0, #0x2e]",
      "done:",
      "pop {r4-r6, pc}",
      ".ltorg"
    ]
  },
