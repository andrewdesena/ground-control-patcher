{
  "name": "LED bit-map diagnostic",
  "status": "diagnostic",
  "description": "Diagnostic sweep: lights key bits 0..23 one at a time in bit order, repeating. Watch one full cycle and report the order the keys light. Flash alone (untick Polyphony v1.1).",
  "cave": {
    "addr": "0x08048A00",
    "asm": [
      "push {r4, r5, lr}",
      "ldr r4, =0x1000FF10",
      "ldrh r0, [r4]",
      "adds r0, #1",
      "strh r0, [r4]",
      "cmp r0, #0x800",
      "bne 1f",
      "movs r0, #0",
      "strh r0, [r4]",
      "ldrb r1, [r4, #2]",
      "adds r1, #1",
      "cmp r1, #24",
      "blt 2f",
      "movs r1, #0",
      "2:",
      "strb r1, [r4, #2]",
      "1:",
      "ldrb r1, [r4, #2]",
      "ldr r5, =0x20001E74",
      "movs r0, #0",
      "strb r0, [r5, #0]",
      "strb r0, [r5, #1]",
      "strb r0, [r5, #2]",
      "lsrs r2, r1, #3",
      "and r1, r1, #7",
      "movs r0, #1",
      "lsls r0, r0, r1",
      "strb r0, [r5, r2]",
      "pop {r4, r5, lr}",
      "ldr r1, =0x20001E74",
      "ldr r0, =0x20002B2C",
      "bx lr"
    ]
  },
  "patches": [
    {
      "addr": "0x08012068",
      "asm": [
        "bl 0x08048800"
      ],
      "note": "force all key bits in the output buffer before SPI shift-out"
    }
  ],
  "requires": {
    "blank": [
      "0x08048800",
      "0x080488FF"
    ]
  }
}
