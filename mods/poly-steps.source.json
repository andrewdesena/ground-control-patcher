{
  "name": "poly-steps",
  "status": "experimental",
  "description": "Layer 2 of polyphony: the per-step note array. Each step stores up to CAP=16 (note,velocity) pairs instead of one byte. Layout: byte0=count, then entries [note,vel] at dst+1+2*i. poly_merge(dst,note,vel) adds or velocity-updates a note (used per note-on); poly_remove(dst,note) removes on note-off; poly_count(dst) returns count. All position-independent.",
  "cave": {
    "addr": "0x08047100",
    "asm": [
      "push {r4, r5, r6, lr}",
      "ldrb r3, [r0]",
      "movs r4, #0",
      "1:",
      "cmp r4, r3",
      "bhs 3f",
      "add r5, r0, #1",
      "add r5, r5, r4, lsl #1",
      "ldrb r6, [r5]",
      "cmp r6, r1",
      "beq 2f",
      "adds r4, #1",
      "b 1b",
      "2:",
      "strb r2, [r5, #1]",
      "b 4f",
      "3:",
      "cmp r3, #16",
      "bhs 4f",
      "add r5, r0, #1",
      "add r5, r5, r3, lsl #1",
      "strb r1, [r5]",
      "strb r2, [r5, #1]",
      "adds r3, #1",
      "strb r3, [r0]",
      "4:",
      "mov r0, r3",
      "pop {r4, r5, r6, pc}"
    ]
  },
  "test_routines": {
    "poly_remove": [
      "push {r4, r5, r6, r7, lr}",
      "ldrb r3, [r0]",
      "movs r4, #0",
      "1:",
      "cmp r4, r3",
      "bhs 4f",
      "add r5, r0, #1",
      "add r5, r5, r4, lsl #1",
      "ldrb r6, [r5]",
      "cmp r6, r1",
      "beq 2f",
      "adds r4, #1",
      "b 1b",
      "2:",
      "subs r3, #1",
      "cmp r4, r3",
      "beq 3f",
      "add r6, r0, #1",
      "add r6, r6, r3, lsl #1",
      "ldrb r7, [r6]",
      "strb r7, [r5]",
      "ldrb r7, [r6, #1]",
      "strb r7, [r5, #1]",
      "3:",
      "strb r3, [r0]",
      "4:",
      "mov r0, r3",
      "pop {r4, r5, r6, r7, pc}"
    ],
    "poly_count": [
      "ldrb r0, [r0]",
      "bx lr"
    ]
  },
  "patches": [],
  "requires": { "blank": ["0x08047100", "0x08047FFF"] }
}
