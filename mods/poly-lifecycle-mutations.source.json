{
  "name": "Chord lifecycle mutation consistency",
  "status": "experimental",
  "description": "Whole clear, fill clear and both rotation directions keep owned chord records synchronized under stock mutation locking. No file I/O or lock acquisition. Ownership words at 0x1000D740 contain letter index plus one, or zero for unknown.",
  "cave": {
    "addr": "0x0804b000",
    "asm": [
      "push {r4-r7, lr}",
      "sub sp, #4",
      "mov r4, r0",
      "ldr r5, =0x08038370",
      "movs r6, #0",
      "slot:",
      "ldr r1, [r5, r6, lsl #2]",
      "ldrb r2, [r1, #0x2d]",
      "cmp r2, #1",
      "beq next_slot",
      "adds r1, #0x34",
      "movs r7, #0",
      "letter:",
      "cmp r1, r4",
      "beq found",
      "addw r1, r1, #0x194",
      "adds r7, #1",
      "cmp r7, #24",
      "blo letter",
      "next_slot:",
      "adds r6, #1",
      "cmp r6, #4",
      "blo slot",
      "none:",
      "movs r0, #0",
      "b done",
      "found:",
      "ldr r1, =0x1000d740",
      "ldr r2, [r1, r6, lsl #2]",
      "adds r7, #1",
      "cmp r2, r7",
      "bne none",
      "ldr r0, =0x1000b530",
      "movw r1, #0x880",
      "mla r0, r6, r1, r0",
      "done:",
      "add sp, #4",
      "pop {r4-r7, pc}"
    ]
  },
